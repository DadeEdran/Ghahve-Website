# ══════════════════════════════════════════════════
# تنظیمات سرور API — نمونهٔ قابل انتشار
#
# این فایل را به server/.env کپی کنید و مقدارها را
# پر کنید. خودِ .env در .gitignore است و نباید منتشر
# شود.
#
# سایت (Next) فایل تنظیمات جداگانهٔ خودش را دارد:
# web/.env.example → web/.env.local
#
# NODE_ENV اینجا نوشته نمی‌شود؛ آن را دستور اجرا تعیین
# می‌کند. با NODE_ENV=production سه چیز عوض می‌شود:
# CLIENT_ORIGIN اجباری می‌شود، HSTS روشن می‌شود، و
# اعتماد به پراکسی خودبه‌خود فعال می‌شود.
# ══════════════════════════════════════════════════

# ── پورت شنود ──
# فقط پورتِ API. بازدیدکننده هیچ‌وقت مستقیم با این پورت
# کار ندارد؛ مرورگر با سایت (۳۰۰۰) حرف می‌زند و Next
# مسیرهای /api و /uploads و sitemap.xml و robots.txt را
# به اینجا می‌فرستد.
PORT=4000

# ── پایگاه داده (اجباری) ──
# مونگو‌دی‌بی روی همین کامپیوتر. برای اتلس فقط همین یک
# خط را عوض کنید. اگر تنظیم نشود، سرور با پیام خطا بالا
# نمی‌آید.
MONGODB_URI=mongodb://127.0.0.1:27017/ghahve

# ── امنیت (اجباری) ──
# کلید امضای توکن ورود مدیر. یک رشتهٔ تصادفی بلند
# بگذارید و در جایی منتشرش نکنید. عوض کردنش همهٔ
# نشست‌های باز را باطل می‌کند.
#   PowerShell:  [guid]::NewGuid().ToString('N') + [guid]::NewGuid().ToString('N')
JWT_SECRET=یک-رشتهٔ-تصادفی-بلند-اینجا-بگذارید

# چند ساعت نشست مدیر باز بماند (پیش‌فرض ۱۲).
TOKEN_HOURS=12

# ── حساب مدیر اولیه ──
# فقط بار اولِ seed استفاده می‌شوند. اگر حساب از قبل
# باشد، seed دست‌نخورده رهایش می‌کند (مگر با --reset).
# رمز را بعد از اولین ورود از پنل عوض کنید.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me

# ── آدرس عمومی سایت (سئو) ──
# پایهٔ همهٔ آدرس‌های مطلقی که سرور تولید می‌کند: لینک‌های
# داخل sitemap.xml و خط Sitemap در robots.txt.
#
# این آدرسِ **سایت** است، نه پورت این سرور. بازدیدکننده
# صفحه‌ها را از ۳۰۰۰ می‌گیرد، پس نقشهٔ سایت هم باید به
# همان‌جا اشاره کند — وگرنه گوگل به آدرس‌هایی هدایت
# می‌شود که فقط API می‌دهند.
#
# باید با NEXT_PUBLIC_SITE_URL در web/.env.local
# **دقیقاً یکی** باشد: آن یکی canonical و og:url هر صفحه
# را می‌سازد و این یکی لینک‌های نقشهٔ سایت را. اگر فرق
# کنند، گوگل دو نسخه از یک صفحه می‌بیند.
#
# بدون / انتهایی بنویسید (اسلش اضافه خودکار حذف می‌شود).
# اگر خالی باشد، از Host خودِ درخواست ساخته می‌شود — که
# در توسعه راه می‌افتد ولی در تولید نباید به آن تکیه
# کرد: پشت پراکسی، Host چیزی است که مشتری فرستاده.
SITE_URL=http://localhost:3000

# ── آدرس مجاز برای CORS ──
# اینجا هم آدرسِ **سایت** است، نه این سرور: مرورگر
# درخواست‌هایش را به مبدأ ۳۰۰۰ می‌زند.
#
# در تولید (NODE_ENV=production) اجباری است؛ اگر خالی
# باشد سرور با پیام خطا بالا نمی‌آید، چون نبودنش یعنی
# «هر مبدأیی مجاز است». در توسعه خالی گذاشتنش اشکالی
# ندارد.
#
# چند مبدأ را با کاما جدا کنید:
#   CLIENT_ORIGIN=https://daneh.coffee,https://www.daneh.coffee
CLIENT_ORIGIN=http://localhost:3000

# ── محدودیت نرخ (بر پایهٔ IP) ──
# هر چهار جفت اختیاری‌اند؛ عددِ خالی یا بی‌معنی به
# پیش‌فرض برمی‌گردد.

# ورود مدیر: چند تلاش، در چند دقیقه
RATE_LIMIT_LOGIN_MAX=5
RATE_LIMIT_LOGIN_WINDOW_MIN=15

# ثبت سفارش: چند سفارش، در چند دقیقه
RATE_LIMIT_ORDER_MAX=5
RATE_LIMIT_ORDER_WINDOW_MIN=60

# پیگیری سفارش (/api/orders/track): چند تلاش، در چند
# دقیقه. سخاوتمندتر از ثبت سفارش (مشتری ممکن است چند بار
# غلط تایپ کند) ولی نه آن‌قدر که بشود شمارهٔ سفارش‌ها را
# یکی‌یکی حدس زد.
RATE_LIMIT_TRACK_MAX=20
RATE_LIMIT_TRACK_WINDOW_MIN=15

# برای آزمایش دستی می‌شود موقتاً خاموشش کرد (در تست
# خودکار همیشه خاموش است). در تولید هرگز ۱ نگذارید.
# RATE_LIMIT_DISABLED=1

# ── پشت پراکسی ──
# اگر سرور پشت nginx یا کلادفلر است، این را ۱ کنید تا
# محدودیت نرخ آدرس واقعی مشتری را ببیند نه آدرس پراکسی
# را. در تولید (NODE_ENV=production) خودبه‌خود روشن است.
#
# جایی که پراکسی نیست روشنش نکنید: کلاینت می‌تواند
# X-Forwarded-For جعلی بفرستد و محدودیت را دور بزند.
# TRUST_PROXY=1
