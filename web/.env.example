# ══════════════════════════════════════════════════
# متغیرهای محیطی Next — نمونهٔ قابل انتشار
#
# این فایل را به web/.env.local کپی کنید. خودِ
# .env.local در .gitignore است.
#
# هرچه با NEXT_PUBLIC_ شروع شود داخل باندل مرورگر
# می‌نشیند و برای همه قابل دیدن است؛ بقیه فقط روی سرور
# خوانده می‌شوند. پس هیچ‌وقت چیز محرمانه‌ای را با پیشوند
# NEXT_PUBLIC_ نگذارید.
#
# سرور API فایل تنظیمات جداگانهٔ خودش را دارد:
# server/.env.example → server/.env
# ══════════════════════════════════════════════════

# ── آدرس سرور Express ──
# فقط روی سرور استفاده می‌شود، در دو جا: پراکسیِ /api و
# /uploads و sitemap.xml و robots.txt در next.config.mjs،
# و خواندن کالاها موقع رندر صفحه‌ها در lib/data.js.
#
# مرورگر همیشه آدرس نسبی می‌زند و این مقدار هیچ‌وقت به
# دستش نمی‌رسد — عمداً پیشوند NEXT_PUBLIC_ ندارد.
#
# اگر Next و Express روی یک ماشین‌اند، همین درست است.
# پیش‌فرضِ کد هم همین است، پس در توسعه می‌شود خالی
# گذاشتش.
API_URL=http://localhost:4000

# ── آدرس عمومی سایت (سئو) ──
# پایهٔ canonical و og:url هر صفحه و آدرس‌های داخل
# Product schema.
#
# باید با SITE_URL در server/.env **دقیقاً یکی** باشد:
# این یکی متادیتای صفحه‌ها را می‌سازد و آن یکی لینک‌های
# داخل sitemap.xml را. اگر فرق کنند، گوگل دو نسخه از یک
# صفحه می‌بیند و نقشهٔ سایت به آدرسی اشاره می‌کند که
# canonical تأییدش نمی‌کند.
#
# بدون / انتهایی. اگر خالی بماند، در توسعه به همین
# لوکال‌هاست برمی‌گردیم و آدرس‌ها نسبی ساخته می‌شوند؛
# در تولید حتماً پرش کنید.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# پورت سایت را اینجا تنظیم **نکنید**: آن را پرچم -p در
# package.json تعیین می‌کند (`next dev -p 3000`). Next
# مقدار PORT را در lib/site.js فقط به‌عنوان آخرین
# جانشینِ metadataBase می‌خواند، آن هم وقتی
# NEXT_PUBLIC_SITE_URL خالی باشد.
# PORT=3000

# ── تصویر پیش‌نمایش لینک ──
# چیزی که تلگرام و واتساپ کنار لینک نشان می‌دهند، وقتی
# خودِ کالا عکس آپلودی ندارد. باید رستری باشد (PNG یا
# JPG) نه SVG — پیش‌نمایش‌سازها SVG را رندر نمی‌کنند.
# اندازهٔ پیشنهادی ۱۲۰۰×۶۳۰.
#
# اختیاری است: بدون آن از /img/og-default.png استفاده
# می‌شود که با `npm run og:image` ساخته می‌شود.
NEXT_PUBLIC_OG_IMAGE=/img/og-default.png
